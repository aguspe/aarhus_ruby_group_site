<%= form_with model: [:admin, event] do |f| %>
  <% if event.errors.any? %>
    <div class="form-errors">
      <h4><%= pluralize(event.errors.count, "error") %> prevented this event from being saved:</h4>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :title %>
    <%= f.text_field :title, placeholder: "Ruby and AI: What is the role of Ruby?" %>
  </div>

  <div class="form-group">
    <%= f.label :description %>
    <%= f.text_area :description, placeholder: "What will this meetup be about?" %>
  </div>

  <div class="form-group">
    <%= f.label :starts_at, "Date & Time" %>
    <%= f.datetime_local_field :starts_at %>
  </div>

  <div class="form-group">
    <%= f.label :location, "Venue name" %>
    <%= f.text_field :location, placeholder: "LYNfabrikken" %>
  </div>

  <div class="form-group">
    <%= f.label :address %>
    <%= f.text_field :address, placeholder: "Vestergade 49B, 8000 Aarhus" %>
  </div>

  <div class="form-group">
    <%= f.label :capacity, "Capacity (leave blank for unlimited)" %>
    <%= f.number_field :capacity, min: 1 %>
  </div>

  <div class="form-group">
    <%= f.label :published do %>
      <%= f.check_box :published %>
      Published (visible to the public)
    <% end %>
  </div>

  <div class="form-group">
    <%= f.submit class: "btn-primary" %>
  </div>
<% end %>
