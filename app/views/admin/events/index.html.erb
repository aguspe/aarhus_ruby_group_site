<section class="admin-page">
  <div class="admin-inner">
    <div class="admin-header">
      <div>
        <span class="section-label">Admin</span>
        <h2 class="section-title">Events</h2>
      </div>
      <%= link_to "New Event", new_admin_event_path, class: "btn-primary" %>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Date</th>
          <th>Title</th>
          <th>Location</th>
          <th>RSVPs</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= event.starts_at.strftime("%b %-d, %Y") %></td>
            <td><strong><%= event.title %></strong></td>
            <td><%= event.location %></td>
            <td><%= event.attending_count %></td>
            <td>
              <span class="status-badge <%= event.published? ? 'published' : 'draft' %>">
                <%= event.published? ? "Published" : "Draft" %>
              </span>
            </td>
            <td>
              <div class="admin-actions">
                <%= link_to "Edit", edit_admin_event_path(event) %>
                <%= link_to "View", event_path(event) if event.published? %>
                <%= button_to "Delete", admin_event_path(event), method: :delete, class: "admin-actions", data: { turbo_confirm: "Are you sure?" }, style: "border: none; background: none; color: var(--muted); font-size: 0.82rem; cursor: pointer; padding: 0; font-family: 'Poppins', sans-serif;" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
