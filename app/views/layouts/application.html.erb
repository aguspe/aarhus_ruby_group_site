<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0c0e11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <title><%= content_for(:title) || "Aarhus Ruby Meetup" %></title>
    <meta name="description" content="Bi-monthly meetups for Ruby developers of all levels in Aarhus, Denmark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,700;1,400&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render "shared/nav" %>

    <%= yield %>

    <%= render "shared/footer" %>
    <%= render "shared/tabbar" %>

    <% if notice.present? %>
      <div id="flash-notice" class="flash-notice" data-controller="flash"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div id="flash-alert" class="flash-alert" data-controller="flash"><%= alert %></div>
    <% end %>
  </body>
</html>
