<% next_event = Event.published.upcoming.first %>
<% recent = Event.published.upcoming.limit(4).to_a %>
<% recent = (Event.published.past.limit(4 - recent.size).to_a.reverse + recent) if recent.size < 4 %>

<!-- HERO -->
<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="prm"><b>$</b> ruby aarhus.rb</div>
      <div class="hero-word">
        <div class="kicker">Aarhus</div>
        <div class="disp big">RUBY<br>MEETUP</div>
      </div>
      <p class="hero-tagline">Bi-monthly meetups for Ruby developers of all levels.</p>
      <div class="prm hero-note"># every other month &middot; Dentsu Aarhus, Åboulevarden 18, 2nd floor &middot; free</div>
    </div>

    <% if next_event %>
      <div class="card next">
        <div class="next-head">
          <span class="ok">=&gt; next_meetup</span>
          <span class="mut"><%= next_event.today? ? "today" : "in #{distance_of_time_in_words(Time.current, next_event.starts_at)}" %></span>
        </div>
        <div class="disp next-date"><%= next_event.starts_at.strftime("%-d %b") %> <span><%= next_event.starts_at.strftime("%H:%M") %></span></div>
        <div class="next-title"><%= next_event.title %></div>
        <div class="prm next-where"><%= [next_event.location, next_event.address].compact_blank.join(" · ") %></div>
        <div class="next-actions">
          <%= link_to "Count me in", event_path(next_event), class: "btn-primary" %>
          <%= link_to "Details", event_path(next_event), class: "btn-secondary" %>
        </div>
      </div>
    <% else %>
      <div class="card next">
        <div class="next-head"><span class="ok">=&gt; next_meetup</span><span class="mut">nil</span></div>
        <div class="next-title">Next date coming soon — join Slack to hear first.</div>
        <div class="next-actions">
          <a class="btn-primary" href="https://join.slack.com/t/aarhusrubygroup/shared_invite/zt-4bbzwzzok-cEvRvcpFspxxPc8RxszkOQ" target="_blank" rel="noopener">Join Slack ↗</a>
        </div>
      </div>
    <% end %>
  </div>

  <div class="wrap cmds">
    <%= link_to "$ ls schedule", events_path, class: "btn-secondary btn-pill" %>
    <a class="btn-secondary btn-pill" href="#organizer">$ whoami</a>
    <a class="btn-secondary btn-pill" href="#speak">$ propose talk</a>
  </div>
</section>

<div class="wrap cols">
  <div>
    <!-- SCHEDULE -->
    <div class="sec" id="meetups">
      <div class="prm"><b>$</b> ls schedule/<%= Date.current.year %></div>
      <div class="meetup-list">
        <% recent.each do |event| %>
          <%= render "events/card", event: event %>
        <% end %>
        <div class="meetup-empty">tba — your talk? <a href="#speak" style="color:var(--fg)">propose one →</a></div>
      </div>
      <div style="margin-top:12px"><%= link_to "all meetups →", events_path, class: "prm" %></div>
    </div>

    <%= render "shared/community" %>
  </div>

  <div>
    <%= render "shared/organizer" %>

    <!-- PROPOSE A TALK -->
    <div class="sec propose" id="speak">
      <div class="prm"><b>$</b> propose --talk</div>
      <div class="disp propose-title">Got 5 or 25 minutes of Ruby in you?</div>
      <p class="propose-sub">First talk or fiftieth — we'll help you shape it. Lightning talks welcome.</p>
      <a class="btn-secondary" href="mailto:augustin.gbpe@gmail.com?subject=Talk%20proposal%20%E2%80%94%20Aarhus%20Ruby%20Meetup">Propose a talk</a>
    </div>

    <!-- ABOUT -->
    <div class="sec" id="about">
      <div class="prm"><b>$</b> cat about.md</div>
      <div class="about-lines">
        <div><span class="ok">#</span> community-driven — volunteers who love Ruby and Aarhus</div>
        <div><span class="ok">#</span> all levels — from <code>puts "hello"</code> to core contributor</div>
        <div><span class="ok">#</span> every other month, hosted at Dentsu Aarhus</div>
      </div>
    </div>
  </div>
</div>
